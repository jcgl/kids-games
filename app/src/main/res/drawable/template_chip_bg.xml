<?xml version="1.0" encoding="utf-8"?>
<!-- Chip seleccionable para el selector de plantillas del módulo Colorear.
     Seleccionado: relleno coral. Sin seleccionar: pastilla blanca con borde suave. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_coral" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="@color/card_coral_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="#22000000" />
        </shape>
    </item>
</selector>
