<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_bg"
    android:padding="16dp"
    tools:context=".PlaygroundActivity">

    <TextView
        android:id="@+id/playgroundTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Playground"
        android:textColor="@color/kids_title"
        android:textSize="40sp"
        android:textStyle="bold"
        android:shadowColor="@color/kids_title_shadow"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/playgroundInstructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Selecciona Números o Letras para practicar trazado gigante."
        android:textColor="@color/kids_subtitle"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playgroundTitle" />

    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/playgroundInstructions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/categoriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNumbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_sunny"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/icon_badge_bg"
                        android:gravity="center"
                        android:text="123"
                        android:textColor="@color/text_on_card"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔢 Números"
                            android:textColor="@color/text_on_card"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Del 1 al 20"
                            android:textColor="@color/text_on_card_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="›"
                        android:textColor="@color/text_on_card"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUpper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_teal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/icon_badge_bg"
                        android:gravity="center"
                        android:text="ABC"
                        android:textColor="@color/text_on_card"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔠 Mayúsculas"
                            android:textColor="@color/text_on_card"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="De la A a la Z"
                            android:textColor="@color/text_on_card_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="›"
                        android:textColor="@color/text_on_card"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_violet"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/icon_badge_bg"
                        android:gravity="center"
                        android:text="abc"
                        android:textColor="@color/text_on_card"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔡 Minúsculas"
                            android:textColor="@color/text_on_card"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="De la a a la z"
                            android:textColor="@color/text_on_card_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="›"
                        android:textColor="@color/text_on_card"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <GridLayout
            android:id="@+id/selectionGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:columnCount="5"
            android:rowCount="5"
            android:useDefaultMargins="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠  Ir al inicio"
                android:background="@drawable/nav_button_bg"
                android:backgroundTint="@color/card_violet"
                android:textColor="@color/text_on_card"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/traceContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/playgroundInstructions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/traceContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/canvas_paper_bg"
            android:padding="6dp"
            android:clipToOutline="true"
            android:elevation="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorToolsPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tools_panel_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:elevation="4dp"
                android:visibility="gone">

                <View
                    android:id="@+id/btnColorRed"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:contentDescription="Rojo" />

                <View
                    android:id="@+id/btnColorBlue"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@android:color/holo_blue_dark"
                    android:contentDescription="Azul" />

                <View
                    android:id="@+id/btnColorYellow"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@android:color/holo_orange_light"
                    android:contentDescription="Amarillo" />

                <View
                    android:id="@+id/btnColorGreen"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@android:color/holo_green_dark"
                    android:contentDescription="Verde" />

                <View
                    android:id="@+id/btnColorPurple"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@android:color/holo_purple"
                    android:contentDescription="Morado" />

                <View
                    android:id="@+id/btnColorBrown"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@color/brown"
                    android:contentDescription="Café" />

                <View
                    android:id="@+id/btnColorPink"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@color/pink"
                    android:contentDescription="Rosa" />

                <View
                    android:id="@+id/btnColorBlack"
                    android:layout_width="52dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/pencil_button_bg"
                    android:backgroundTint="@color/black"
                    android:contentDescription="Negro" />

                <View
                    android:id="@+id/btnColorWhite"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/white_circle_border_bg"
                    android:contentDescription="Blanco, pinta en blanco sobre el dibujo" />

                <ImageButton
                    android:id="@+id/btnRevertColoring"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/white_circle_border_bg"
                    android:padding="12dp"
                    android:src="@drawable/ic_trash"
                    android:tint="@color/black"
                    android:contentDescription="Deshacer coloreado con cesto de basura" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/traceControlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnDraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dibujar"
                android:visibility="gone" />

            <TextView
                android:id="@+id/traceCharacterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Número 1"
                android:textColor="@color/kids_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnBackFromTrace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Volver a selección"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/nav_button_bg"
                    android:backgroundTint="@color/card_teal"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnHomeFromTrace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏠  Ir al inicio"
                    android:background="@drawable/nav_button_bg"
                    android:backgroundTint="@color/card_violet"
                    android:textColor="@color/text_on_card"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
