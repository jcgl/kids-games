<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="KidsGames"
        android:theme="@style/Theme.KidsGames">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ColoringActivity" android:exported="false" />
        <activity android:name=".TracingActivity" android:exported="false" />
        <activity android:name=".CanvasActivity" android:exported="false" />
        <activity android:name=".PlaygroundActivity" android:exported="false" />
        <activity android:name=".CreationsActivity" android:exported="false" />
    </application>

</manifest>
